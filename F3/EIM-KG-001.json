    "MODULATES": {
      "_description": "REL-07. Una variable afecta la interpretación de otra sin ser su causa directa. No implica causalidad (RC-06).",
      "_metamodel_ref": "MSI-META-001 § REL-07",
      "items": [
        {
          "id": "REL-07-L2011-L3004",
          "from": "V-L2-011",
          "to": "V-L3-004",
          "modulates_aspect": "Peso del componente de volumen en el score de coherencia",
          "description": "Volumen bajo reduce el peso del COHERENCE_SCORE. Señal sin volumen tiene menor confianza (AX-07)."
        },
        {
          "id": "REL-07-L2011-L3005",
          "from": "V-L2-011",
          "to": "V-L3-005",
          "modulates_aspect": "Amplificación de fricción en contexto de bajo volumen",
          "description": "Volumen bajo amplifica la lectura de FRICTION_INDEX. Compresión con bajo volumen = fricción máxima."
        },
        {
          "id": "REL-07-L2029-L2006",
          "from": "V-L2-029",
          "to": "V-L2-006",
          "modulates_aspect": "Significancia relativa del spread en contexto de volatilidad",
          "description": "ATR_RELATIVE contextualiza SPREAD_9_21. Un spread del 2% en mercado con ATR 0.5% es expansión extrema; en mercado con ATR 3% es compresión."
        },
        {
          "id": "REL-07-L2029-L2010",
          "from": "V-L2-029",
          "to": "V-L2-010",
          "modulates_aspect": "Significancia relativa de la elasticidad respecto a volatilidad actual",
          "description": "ATR_RELATIVE contextualiza ELASTICITY. El mismo alejamiento del precio respecto a EMA-200 tiene distinta lectura según la volatilidad del mercado."
        },
        {
          "id": "REL-07-L2021-L4001",
          "from": "V-L2-021",
          "to": "V-L4-001",
          "modulates_aspect": "Confianza global del diagnóstico por confirmación multi-timeframe",
          "description": "MTF_SYNC amplifica o reduce la confianza del STRUCTURAL_DIAGNOSIS. Diagnóstico confirmado en múltiples TF tiene confianza máxima. Divergencia entre TF reduce la confianza."
        },
        {
          "id": "REL-07-L2025-L4001",
          "from": "V-L2-025",
          "to": "V-L4-001",
          "modulates_aspect": "Confirmación macro del diagnóstico por respeto a EMA-200",
          "description": "Número de rebotes en EMA-200 modula la confianza del diagnóstico macro. Alto conteo de rebotes valida el régimen. Bajo conteo sugiere posible cambio estructural macro."
        }
      ]
    },
