{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "eim-web",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "eim_web:app",
        "--port",
        "8000",
        "--app-dir",
        "legacy/F7",
        "--reload",
        "--reload-dir",
        "legacy/F7"
      ],
      "port": 8000
    },
    {
      "name": "eim-v2-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "v2/eim/web",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "eim-v2-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "eim.api.main:app",
        "--port",
        "8000"
      ],
      "cwd": "v2",
      "port": 8000
    },
    {
      "name": "eim-v2-operation",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "eim.operation",
        "run",
        "--execution",
        "paper",
        "--poll",
        "60"
      ],
      "cwd": "v2",
      "port": 8000
    },
    {
      "name": "eim-v2-api-running",
      "url": "http://127.0.0.1:8000",
      "port": 8000
    }
  ]
}
